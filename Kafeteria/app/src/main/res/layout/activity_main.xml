<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/logo_kafeteria"
        android:contentDescription="Logo Kafeteria"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kafeteria"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnDrinks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Napoje"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSnacks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Przekąski"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnLocations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Lista lokali" />

    <Button
        android:id="@+id/btnCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:text="Twój Koszyk" />

</LinearLayout>
